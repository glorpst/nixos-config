spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "hyprpaper"
spawn-at-startup "mako"
spawn-at-startup "quickshell"
spawn-at-startup "udiskie" "--no-notify" "--tray"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent0"

// Wallpaper
spawn-at-startup "sh" "-c" "swaybg -o eDP-1 -i ~/Pictures/opt_wallpapers/metropolis.png &"
spawn-at-startup "sh" "-c" "swaybg -o HDMI-A-1 -i ~/Pictures/opt_wallpapers/tall_building.jpg &"

environment {
  XDG_CURRENT_DESKTOP "niri"
  XDG_SESSION_DESKTOP "niri"
  XDG_SESSION_TYPE "wayland"

  QT_QPA_PLATFORM "wayland;xcb"
  QT_QPA_PLATFORMTHEME "gtk3"
  QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
}
